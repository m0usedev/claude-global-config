{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "spanish",
  "theme": "dark",
  "notifications": true,
  "permissions": {
    "allow": [
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Read(/**)",
      "Edit(/src/**)",
      "Edit(/tests/**)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:*.github.com)"
    ],
    "ask": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(ls*)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.*)",
      "Edit(./.env.*)",
      "Read(.env)",
      "Edit(.env)",
      "Read(.env.*)",
      "Edit(.env.*)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)",
      "Read(/**/*.pem)",
      "Edit(/**/*.pem)",
      "Bash(curl *)",
      "Bash(rm -rf *)",
      "Read(~/.zshrc)",
      "Edit(~/.zshrc)",
      "Read(//tmp/scratch)",
      "Edit(//tmp/scratch)",
      "Bash(git push *)"
    ]
  }
}